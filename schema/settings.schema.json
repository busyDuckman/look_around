{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lookaround/lookaround/schema/settings.schema.json",
  "title": "lookaround settings",
  "description": "Structure of a lookaround settings document after loading (the files are YAML). Meaning of each field: docs/spec.md section 4.",
  "type": "object",
  "required": ["spec_version", "name"],
  "additionalProperties": false,
  "properties": {
    "spec_version": { "type": "string", "pattern": "^0\\.2\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "angle_unit": { "enum": ["rad", "deg"], "default": "rad" },
    "max_substep": { "type": "number", "exclusiveMinimum": 0, "default": 0.008333333333333333 },
    "velocity_filter_tau": { "type": "number", "exclusiveMinimum": 0, "default": 0.02 },
    "heading": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/heading" }] },
    "torso": {
      "oneOf": [
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/segment" } }
      ]
    },
    "head": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/head" }] },
    "eyes": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/eyes" }] }
  },
  "anyOf": [
    { "required": ["torso"], "properties": { "torso": { "type": "array", "minItems": 1 } } },
    { "required": ["head"], "properties": { "head": { "type": "object" } } },
    { "required": ["eyes"], "properties": { "eyes": { "type": "object" } } }
  ],
  "$defs": {
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "offset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "xyz": { "$ref": "#/$defs/vec3" },
        "rpy": { "$ref": "#/$defs/vec3" }
      }
    },
    "limits": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "share": {
      "type": "object",
      "additionalProperties": false,
      "required": ["share"],
      "properties": {
        "share": { "type": "number", "minimum": 0 },
        "dead_zone": { "type": "number", "minimum": 0, "default": 0 },
        "softness": { "type": "number", "minimum": 0, "default": 0 }
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pos", "neg"],
      "properties": {
        "pos": { "$ref": "#/$defs/share" },
        "neg": { "$ref": "#/$defs/share" }
      }
    },
    "dynamics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["omega", "v_max"],
      "properties": {
        "omega": { "type": "number", "exclusiveMinimum": 0 },
        "v_max": { "type": "number", "exclusiveMinimum": 0 },
        "a_max": { "oneOf": [{ "type": "null" }, { "type": "number", "exclusiveMinimum": 0 }] },
        "latency": { "type": "number", "minimum": 0 },
        "deadband": { "type": "number", "minimum": 0 },
        "max_lead": { "oneOf": [{ "type": "null" }, { "type": "number", "exclusiveMinimum": 0 }] }
      }
    },
    "axis_common": {
      "type": "object",
      "properties": {
        "limits": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/limits" }] },
        "rest": { "type": "number" },
        "dynamics": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/dynamics" }] }
      }
    },
    "axis_split": {
      "allOf": [{ "$ref": "#/$defs/axis_common" }],
      "unevaluatedProperties": false,
      "properties": { "split": { "$ref": "#/$defs/split" } }
    },
    "axis_plain": {
      "allOf": [{ "$ref": "#/$defs/axis_common" }],
      "unevaluatedProperties": false
    },
    "axis_split_limited": {
      "allOf": [{ "$ref": "#/$defs/axis_split" }],
      "required": ["limits"],
      "properties": { "limits": { "$ref": "#/$defs/limits" } }
    },
    "axis_plain_limited": {
      "allOf": [{ "$ref": "#/$defs/axis_plain" }],
      "required": ["limits"],
      "properties": { "limits": { "$ref": "#/$defs/limits" } }
    },
    "part_common": {
      "type": "object",
      "required": ["yaw"],
      "properties": {
        "external": { "type": "boolean", "default": false },
        "offset": { "$ref": "#/$defs/offset" },
        "actuator_latency": { "type": "number", "minimum": 0 }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "turn_now": { "type": "number", "minimum": 0 },
        "dwell_angle": { "type": "number", "minimum": 0 },
        "dwell_time": { "type": "number", "minimum": 0 },
        "settle_angle": { "type": "number", "minimum": 0 }
      }
    },
    "heading": {
      "type": "object",
      "required": ["yaw"],
      "additionalProperties": false,
      "properties": {
        "external": { "type": "boolean", "default": false },
        "actuator_latency": { "type": "number", "minimum": 0 },
        "yaw": { "$ref": "#/$defs/axis_plain" },
        "decision": { "$ref": "#/$defs/decision" }
      }
    },
    "segment": {
      "allOf": [{ "$ref": "#/$defs/part_common" }],
      "unevaluatedProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "yaw": { "$ref": "#/$defs/axis_split" }
      }
    },
    "head": {
      "allOf": [{ "$ref": "#/$defs/part_common" }],
      "required": ["pitch"],
      "unevaluatedProperties": false,
      "properties": {
        "yaw": { "$ref": "#/$defs/axis_split" },
        "pitch": { "$ref": "#/$defs/axis_split_limited" }
      }
    },
    "eyes": {
      "allOf": [{ "$ref": "#/$defs/part_common" }],
      "required": ["pitch"],
      "unevaluatedProperties": false,
      "properties": {
        "binocular": { "type": "boolean", "default": false },
        "ipd": { "type": "number", "exclusiveMinimum": 0 },
        "yaw": { "$ref": "#/$defs/axis_plain_limited" },
        "pitch": { "$ref": "#/$defs/axis_plain_limited" }
      }
    }
  }
}
